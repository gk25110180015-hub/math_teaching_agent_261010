{
  "section_id": "S01",
  "units": [
    {
      "id": "S01.U01",
      "kind": "definition",
      "tex": "称实数列 $a_n$ 收敛于 $a$，如果对每个 $\\varepsilon>0$，存在正整数 $N$，使得所有 $n>N$ 都满足 $|a_n-a|<\\varepsilon$。",
      "relates_to": null
    },
    {
      "id": "S01.U02",
      "kind": "theorem",
      "tex": "收敛实数列的极限唯一。",
      "relates_to": null
    },
    {
      "id": "S01.U03",
      "kind": "proof",
      "tex": "若极限 $a\\ne b$，取 $\\varepsilon=|a-b|/3>0$。由两次收敛定义，充分大的 $n$ 同时满足 $|a_n-a|<\\varepsilon$ 和 $|a_n-b|<\\varepsilon$。三角不等式给出 $|a-b|<2|a-b|/3$，矛盾。",
      "relates_to": "S01.U02"
    },
    {
      "id": "S01.U04",
      "kind": "example",
      "tex": "证明 $a_n=1/n$ 收敛于 $0$。",
      "relates_to": null
    },
    {
      "id": "S01.U05",
      "kind": "solution",
      "tex": "任取 $\\varepsilon>0$，取正整数 $N>1/\\varepsilon$。当 $n>N$ 时，$|1/n-0|=1/n<1/N<\\varepsilon$。故所求极限为 $0$。",
      "relates_to": "S01.U04"
    },
    {
      "id": "S01.E01",
      "kind": "exercise",
      "tex": "按定义证明 $3/n\\to0$。",
      "relates_to": null
    },
    {
      "id": "S01.A01",
      "kind": "solution",
      "tex": "取正整数 $N>3/\\varepsilon$，则 $n>N$ 时 $3/n<\\varepsilon$。",
      "relates_to": "S01.E01"
    }
  ],
  "calculations": [],
  "calculation_limitations": [],
  "uncertainties": []
}