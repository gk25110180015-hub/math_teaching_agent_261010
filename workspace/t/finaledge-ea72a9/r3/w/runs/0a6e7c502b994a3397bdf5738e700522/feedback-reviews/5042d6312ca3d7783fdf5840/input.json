  "units": [
    {
      "id": "S01.U01",
      "kind": "definition",
      "relates_to": null,
      "tex": "称实数列 $a_n$ 收敛于 $a$，如果对每个 $\\varepsilon>0$，存在正整数 $N$，使得所有 $n>N$ 都满足 $|a_n-a|<\\varepsilon$。"
    },
    {
      "id": "S01.U02",
      "kind": "theorem",
      "relates_to": null,
      "tex": "收敛实数列的极限唯一。"
    },
    {
      "id": "S01.U03",
      "kind": "proof",
      "relates_to": "S01.U02",
      "tex": "若极限 $a\\ne b$，取 $\\varepsilon=|a-b|/3>0$。由两次收敛定义，充分大的 $n$ 同时满足 $|a_n-a|<\\varepsilon$ 和 $|a_n-b|<\\varepsilon$。三角不等式给出 $|a-b|<2|a-b|/3$，矛盾。"
    },
    {
      "id": "S01.U04",
      "kind": "example",
      "relates_to": null,
      "tex": "证明 $a_n=1/n$ 收敛于 $0$。"
    },
    {
      "id": "S01.U05",
      "kind": "solution",
      "relates_to": "S01.U04",
      "tex": "任取 $\\varepsilon>0$，取正整数 $N>1/\\varepsilon$。当 $n>N$ 时，$|1/n-0|=1/n<1/N<\\varepsilon$。故所求极限为 $0$。"
    },
    {
      "id": "S01.E01",
      "kind": "exercise",
      "relates_to": null,
      "tex": "按定义证明 $3/n\\to0$。"
    },
    {
      "id": "S01.A01",
      "kind": "solution",
      "relates_to": "S01.E01",
      "tex": "取正整数 $N>3/\\varepsilon$，则 $n>N$ 时 $3/n<\\varepsilon$。"
    },
    {
      "id": "S02.U01",
      "kind": "definition",
      "relates_to": null,
      "tex": "若 $a_n\\to a$，则 $r_n=a_n-a$ 称为余项，并且 $r_n\\to0$。"
    },
    {
      "id": "S02.U02",
      "kind": "theorem",
      "relates_to": null,
      "tex": "若实数列 $a_n\\to a$ 且 $b_n\\to b$，则 $a_n+b_n\\to a+b$。"
    },
    {
      "id": "S02.U03",
      "kind": "proof",
      "relates_to": "S02.U02",
      "tex": "任取 $\\varepsilon>0$，分别对两个收敛数列使用 $\\varepsilon/2$。充分大的 $n$ 满足 $|(a_n+b_n)-(a+b)|\\leq |a_n-a|+|b_n-b|<\\varepsilon$。"
    },
    {
      "id": "S02.U04",
      "kind": "example",
      "relates_to": null,
      "tex": "求 $\\lim_{n\\to\\infty}(2+1/n)$。"
    },
    {
      "id": "S02.U05",
      "kind": "solution",
      "relates_to": "S02.U04",
      "tex": "常数列 $2$ 的极限为 $2$，且 $1/n\\to0$。由加法法则，所求极限为 $2$。"
    },
    {
      "id": "S02.E01",
      "kind": "exercise",
      "relates_to": null,
      "tex": "按定义证明 $5/n\\to0$。"
    },
    {
      "id": "S02.A01",
      "kind": "solution",
      "relates_to": "S02.E01",
      "tex": "取正整数 $N>5/\\varepsilon$，则 $n>N$ 时 $5/n<\\varepsilon$。"
    }
  ],
