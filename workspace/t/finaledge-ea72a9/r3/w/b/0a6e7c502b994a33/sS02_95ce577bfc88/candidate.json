{
  "section_id": "S02",
  "units": [
    {
      "id": "S02.U01",
      "kind": "definition",
      "tex": "若 $a_n\\to a$，则 $r_n=a_n-a$ 称为余项，并且 $r_n\\to0$。",
      "relates_to": null
    },
    {
      "id": "S02.U02",
      "kind": "theorem",
      "tex": "若实数列 $a_n\\to a$ 且 $b_n\\to b$，则 $a_n+b_n\\to a+b$。",
      "relates_to": null
    },
    {
      "id": "S02.U03",
      "kind": "proof",
      "tex": "任取 $\\varepsilon>0$，分别对两个收敛数列使用 $\\varepsilon/2$。充分大的 $n$ 满足 $|(a_n+b_n)-(a+b)|\\leq |a_n-a|+|b_n-b|<\\varepsilon$。",
      "relates_to": "S02.U02"
    },
    {
      "id": "S02.U04",
      "kind": "example",
      "tex": "求 $\\lim_{n\\to\\infty}(2+1/n)$。",
      "relates_to": null
    },
    {
      "id": "S02.U05",
      "kind": "solution",
      "tex": "常数列 $2$ 的极限为 $2$，且 $1/n\\to0$。由加法法则，所求极限为 $2$。",
      "relates_to": "S02.U04"
    },
    {
      "id": "S02.E01",
      "kind": "exercise",
      "tex": "按定义证明 $5/n\\to0$。",
      "relates_to": null
    },
    {
      "id": "S02.A01",
      "kind": "solution",
      "tex": "取正整数 $N>5/\\varepsilon$，则 $n>N$ 时 $5/n<\\varepsilon$。",
      "relates_to": "S02.E01"
    }
  ],
  "calculations": [],
  "calculation_limitations": [],
  "uncertainties": []
}