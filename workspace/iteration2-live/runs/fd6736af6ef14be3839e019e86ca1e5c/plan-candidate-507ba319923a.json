{
  "title": "无穷级数：收敛性与基本判别法",
  "objectives": [
    "建立无穷级数、部分和与收敛的基本概念",
    "掌握级数收敛的必要条件及基本运算性质",
    "能够使用正项级数、交错级数和绝对收敛判别法分析级数",
    "区分绝对收敛、条件收敛与发散，并完成基础证明与计算题"
  ],
  "prerequisites": [
    "实数运算与不等式",
    "数列极限的定义与基本性质",
    "函数极限和连续性的初步知识",
    "有限等比数列求和与基本积分估计"
  ],
  "sections": [
    {
      "id": "S01",
      "title": "级数与部分和的基本概念",
      "objectives": [
        "定义无穷级数及其部分和数列",
        "说明级数收敛与部分和数列极限之间的关系",
        "掌握级数收敛、发散和级数和的基本表述",
        "通过基础例题计算部分和或判断简单级数的收敛性"
      ],
      "required_kinds": [
        "definition",
        "theorem",
        "example",
        "solution",
        "proof",
        "exercise"
      ],
      "prerequisites": [],
      "reference_labels": [
        "def:series",
        "def:partial-sum",
        "def:convergence",
        "thm:series-limit"
      ]
    },
    {
      "id": "S02",
      "title": "收敛的必要条件与级数的基本性质",
      "objectives": [
        "证明级数收敛时通项必须趋于零",
        "掌握级数的线性运算、余项和有限项改变性质",
        "利用必要条件快速判断典型发散级数",
        "通过例题分析调和型和常数项级数的基本行为"
      ],
      "required_kinds": [
        "definition",
        "theorem",
        "example",
        "solution",
        "proof",
        "exercise"
      ],
      "prerequisites": [
        "S01"
      ],
      "reference_labels": [
        "def:remainder",
        "thm:term-test",
        "thm:linearity",
        "thm:finite-change"
      ]
    },
    {
      "id": "S03",
      "title": "正项级数及其判别法",
      "objectives": [
        "理解正项级数部分和单调性的作用",
        "掌握比较判别法、极限比较判别法和积分判别法的使用条件",
        "掌握几何级数和p级数等基本参照级数",
        "能够选择合适判别法判断正项级数的收敛性"
      ],
      "required_kinds": [
        "definition",
        "theorem",
        "example",
        "solution",
        "proof",
        "exercise"
      ],
      "prerequisites": [
        "S01",
        "S02"
      ],
      "reference_labels": [
        "def:positive-series",
        "def:p-series",
        "thm:monotone-partial-sums",
        "thm:comparison",
        "thm:limit-comparison",
        "thm:integral-test"
      ]
    },
    {
      "id": "S04",
      "title": "交错级数与条件收敛",
      "objectives": [
        "定义交错级数并识别其符号交替结构",
        "掌握交错级数判别法及其余项估计",
        "区分交错级数的收敛性与绝对收敛性",
        "通过例题估计截断误差并判断条件收敛"
      ],
      "required_kinds": [
        "definition",
        "theorem",
        "example",
        "solution",
        "proof",
        "exercise"
      ],
      "prerequisites": [
        "S02",
        "S03"
      ],
      "reference_labels": [
        "def:alternating-series",
        "thm:alternating-test",
        "thm:alternating-remainder"
      ]
    },
    {
      "id": "S05",
      "title": "绝对收敛、条件收敛与判别法综合",
      "objectives": [
        "定义绝对收敛和条件收敛",
        "证明绝对收敛蕴含收敛",
        "综合使用必要条件、比较判别法、交错级数判别法和绝对收敛判别法",
        "建立面向本科入门题目的判别法选择流程并完成综合练习"
      ],
      "required_kinds": [
        "definition",
        "theorem",
        "example",
        "solution",
        "proof",
        "exercise"
      ],
      "prerequisites": [
        "S03",
        "S04"
      ],
      "reference_labels": [
        "def:absolute-convergence",
        "def:conditional-convergence",
        "thm:absolute-implies-convergence",
        "thm:comparison-summary",
        "thm:convergence-classification"
      ]
    }
  ],
  "symbols": {
    "a_n": "级数的第n项或通项",
    "S_n": "级数的第n个部分和",
    "sum_a_n": "级数Σ_{n=1}^∞ a_n",
    "N": "正整数集合",
    "epsilon": "任意给定的正数",
    "r": "几何级数的公比"
  },
  "exclusions": [
    "不讨论幂级数、函数项级数和傅里叶级数",
    "不讨论一致收敛、逐项积分与逐项求导",
    "不系统展开高等数学中的积分判别法证明细节",
    "不涉及复数项级数"
  ]
}