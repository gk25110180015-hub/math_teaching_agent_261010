            "feedback_hash": "06234869adb0ea50ef8f5edb9e5da5f7fe690e3e7f6abfd2093d47d8640497dd",
            "identity_hash": "79b5a589e0f64a5d838c806ac078b8d527cb40f108980893eeb11db6d7598cc7",
            "items": [
              {
                "id": "F1",
                "objective_evidence": [
                  {
                    "field": "objectives",
                    "quote": "能够运用代数变形、夹逼思想和基本极限完成初等计算。",
                    "section_id": "S02"
                  },
                  {
                    "field": "lecture.exercises",
                    "quote": "with_answers",
                    "section_id": null
                  },
                  {
                    "field": "lecture.answers_location",
                    "quote": "end",
                    "section_id": null
                  }
                ],
                "reason": "现稿已有完整的夹逼计算示范，不能称为“没有夹逼应用”，也不应改写该示范。核查全章练习及其答案后，尚未发现要求学生独立选择上下界并完成夹逼计算的题解配对；基本极限证明中的夹逼属于教师证明，不替代独立训练。S02.U12/U13 目前只训练和、差、商法则及分母条件。因此，补一个短小夹逼小问是批准计算目标内的教学改进，不是纠正现有数学错误。",
                "repair_instruction": "仅修改 S02.U12/U13：保留原商法则题及正确解答，在题面附加一个区别于现有示范的初等夹逼小问，要求学生自行构造上下界、确认定义域及同一趋近过程、计算两端共同极限并给出结论；在对应答案中落实这些步骤。只使用初等有界性和代数极限，不引入导数、泰勒或新单元。保留 S02.U04 原示范与证明，新增答案沿用批准的讲义末尾答案策略。",
                "repair_unit_ids": [
                  "S02.U12",
                  "S02.U13"
                ],
                "status": "supported_improvement",
                "unit_evidence": [
                  {
                    "kind": "worked_example",
                    "quote": "夹逼计算的应用：求 $\\lim_{x\\to0}x^2\\sin(1/x)$。构造上下界时，先利用三角函数的基本性质 $-1\\leq\\sin t\\leq1$，再乘以非负因子 $x^2$。在去心邻域 $0<|x|<1$ 内，$1/x$ 有定义，且\n\\[\n-x^2\\leq x^2\\sin(1/x)\\leq x^2.\n\\]",
                    "unit_id": "S02.U04"
                  },
                  {
                    "kind": "statement",
                    "quote": "设函数 $f$ 与 $g$ 在点 $x_0$ 的某个去心邻域内有定义，且\n\\[\n\\lim_{x\\to x_0}f(x)=2,\n\\qquad\n\\lim_{x\\to x_0}g(x)=-1.\n\\]\n求\n\\[\n\\lim_{x\\to x_0}\\frac{f(x)+g(x)}{f(x)-g(x)}.\n\\]\n并说明使用商的极限法则时需要检查的条件。",
                    "unit_id": "S02.U12"
                  },
                  {
                    "kind": "worked_example",
                    "quote": "分母的极限为 $3\\neq0$，所以分母在 $x_0$ 的某个去心邻域内不为零，可以使用商的极限法则。因此\n\\[\n\\lim_{x\\to x_0}\\frac{f(x)+g(x)}{f(x)-g(x)}=\\frac{1}{3}.\n\\]",
                    "unit_id": "S02.U13"
                  }
                ],
                "unit_ids": [
                  "S02.U04",
                  "S02.U12",
                  "S02.U13"
                ]
              },
              {
                "id": "F2",
                "objective_evidence": [
                  {
                    "field": "objectives",
                    "quote": "理解无穷小及其阶的基本思想，掌握等价无穷小在极限计算中的使用条件。",
                    "section_id": null
                  },
                  {
                    "field": "objectives",
                    "quote": "理解等价无穷小的定义，并能在乘积和商的极限中进行规范替换。",
                    "section_id": "S03"
                  }
                ],
                "reason": "现稿的等价替换条件及加减警告正确，但全章尚无实际的加减抵消反例。S03.U07/U08 是正常的乘积、商计算，不能当作抵消反例，也不能用一般警告认定本项已完成。可在这对既有单元中增加一个代数可核查的对照，使学生看见等价加项替换前后整体极限不同，从而落实批准目标中的使用条件教学。已有阶比较定义及替换定理、证明无需修改。",
                "repair_instruction": "仅修改 S03.U07/U08，保留原题及全部正确解答，附加一个简短的加减抵消对照及解释。所选反例须明确趋近过程和非零分母条件，代数核实两无穷小等价，分别算出原式与错误逐项替换后表达式的不同结果，并指出被替换对象是加减项而非定理所许可的整体乘积因子或商结构，不能套用原定理。可采用反馈建议，也可选择同等初等的其他反例；不依赖导数、泰勒，不新增单元，不重复补定义，不修改正确的替换定理和证明。",
                "repair_unit_ids": [
                  "S03.U07",
                  "S03.U08"
                ],
                "status": "supported_improvement",
                "unit_evidence": [
                  {
                    "kind": "statement",
                    "quote": "因此，在商的极限中，可以将分母中的无穷小 $\\alpha(x)$ 替换为与其等价的无穷小 $\\beta(x)$，但必须同时检查两个商在同一去心邻域内有定义，并且原商的有限极限存在。一般而言，不能在加减式中无条件逐项替换等价无穷小；加减项的替换必须另行检验整体极限，不能仅由等价关系和表达式有定义推出。",
                    "unit_id": "S03.U05"
                  },
                  {
                    "kind": "statement",
                    "quote": "计算\n\\[\n\\lim_{x\\to0}\\frac{(1+x)\\sin x}{x}.\n\\]\n要求说明等价无穷小替换的依据及适用条件。",
                    "unit_id": "S03.U07"
                  },
                  {
                    "kind": "worked_example",
                    "quote": "当 $x\\to0$ 时，$\\sin x\\sim x$，并且 $1+x\\to1$。在 $x\\neq0$ 的去心邻域内，原式有定义，且\n\\[\n\\frac{(1+x)\\sin x}{x}=(1+x)\\frac{\\sin x}{x}.\n\\]",
                    "unit_id": "S03.U08"
                  }
                ],
                "unit_ids": [
                  "S03.U05",
                  "S03.U07",
                  "S03.U08"
                ]
              },
              {
                "id": "F3",
                "objective_evidence": [
                  {
                    "field": "objectives",
                    "quote": "理解闭区间上连续函数的有界性、最值性和介值性，并能解决基础经济学模型中的连续性问题。",
                    "section_id": null
                  },
                  {
                    "field": "objectives",
                    "quote": "能够将连续性定理用于判断方程根的存在性及简单经济学模型的可行性。",
                    "section_id": "S05"
                  }
                ],
                "reason": "两道经济题及对应答案均未明确价格单位、供需数量单位或共同时间尺度，也未说明公式是统一单位下数值之间的简化教学关系。现有连续性、可行性、端点异号及存在性与唯一性的区分不因这一缺口而错误，但数值结论的经济含义仍不够明确。给四个既有单元补充一致的单位和模型限定，是批准经济应用目标内的解释改进。反馈末尾的范围说明是本项处理边界，不构成扩写第二重要极限、数列、多元、导数或泰勒的授权。",
                "repair_instruction": "仅修改 S05.U13/U14/U18/U22 的模型解释及单位表述：在两题题面分别明确这是简化教学模型，p、D、S 为选定统一单位下的数值，指定合理价格单位、数量单位与供需共用的固定时间尺度。答案沿用各自题面的约定，为均衡价格、交易量、超额需求及反例表格和价格区间补充必要的单位说明。保留全部公式、区间、端点数据、数值结果、连续非负条件、正确证明和多均衡反例；不得把教学假设表述为真实市场事实，不增添模型推断或扩写其他数学主题。",
                "repair_unit_ids": [
                  "S05.U13",
                  "S05.U14",
                  "S05.U18",
                  "S05.U22"
                ],
                "status": "supported_improvement",
                "unit_evidence": [
                  {
                    "kind": "model_assumption",
                    "quote": "在价格范围 $p\\in[0,8]$ 内，某商品的需求量与供给量分别为\n\\[\nD(p)=24-2p,\\qquad S(p)=4+p.\n\\]\n先用连续性说明该价格范围内存在供需相等的均衡价格，再求出均衡价格与交易量，并说明唯一性的依据。",
                    "unit_id": "S05.U13"
                  },
                  {
                    "kind": "worked_example",
                    "quote": "解线性方程 $20-3p_*=0$，得\n\\[\np_*=\\frac{20}{3},\\qquad D(p_*)=S(p_*)=\\frac{32}{3}.\n\\]",
                    "unit_id": "S05.U14"
                  },
                  {
                    "kind": "model_assumption",
                    "quote": "某商品在 $p\\in[1,5]$ 上的需求函数 $D$ 和供给函数 $S$ 均连续且非负，满足\n\\[\nD(1)=12,\\quad S(1)=3,\\qquad D(5)=4,\\quad S(5)=8.\n\\]\n证明存在区间内部的均衡价格。若进一步知道 $D$ 严格递减、$S$ 严格递增，证明均衡价格唯一。仅凭最初给出的条件能否断言唯一？",
                    "unit_id": "S05.U18"
                  },
                  {
                    "kind": "worked_example",
                    "quote": "令 $E(p)=D(p)-S(p)$，$p\\in[1,5]$。由连续函数的差仍连续，$E$ 在 $[1,5]$ 上连续，且\n\\[\nE(1)=9>0,\\qquad E(5)=-4<0.\n\\]\n所以存在 $p_*\\in(1,5)$ 使 $E(p_*)=0$，即 $D(p_*)=S(p_*)$。",
                    "unit_id": "S05.U22"
                  },
                  {
                    "kind": "counterexample",
                    "quote": "仅凭最初的连续性和端点数据不能断言唯一。例如，令 $D,S$ 分别在相邻整数价格之间作直线连接，其在 $p=1,2,3,4,5$ 处的值依次为\n\\[\n\\begin{array}{c|ccccc}\np&1&2&3&4&5\\\\\nD(p)&12&4&8&4&4\\\\\nS(p)&3&5&5&5&8\n\\end{array}\n\\]\n所得函数连续且非负，并满足给定端点条件。",
                    "unit_id": "S05.U22"
                  }
                ],
                "unit_ids": [
                  "S05.U13",
                  "S05.U14",
                  "S05.U18",
                  "S05.U22"
                ]
              }
