# Documentation only; the app reads environment variables, not .env files.
MATH_AGENT_HOST=127.0.0.1
MATH_AGENT_PORT=8765
MATH_AGENT_WORKSPACE=./workspace
MATH_AGENT_REFERENCE_ROOT=..
MATH_AGENT_LLM_PROVIDER=mock
MATH_AGENT_API_BASE_URL=https://oneapi.advancedsolver.com/v1
MATH_AGENT_API_KEY=
MATH_AGENT_MODEL=gpt-6-astra
# UI model IDs: gpt6 (default), deepseek-flash, deepseek-v4-pro.
# Both DeepSeek models share this environment-only credential and endpoint.
MATH_AGENT_DEEPSEEK_API_BASE_URL=https://api.deepseek.com
MATH_AGENT_DEEPSEEK_API_KEY=
# DeepSeek request profiles use thinking enabled, reasoning_effort high, stream false.
MATH_AGENT_LIVE_API_ENABLED=false
MATH_AGENT_LLM_CONNECT_TIMEOUT_SECONDS=15
MATH_AGENT_LLM_READ_TIMEOUT_SECONDS=180
MATH_AGENT_LLM_TOTAL_TIMEOUT_SECONDS=240
MATH_AGENT_XELATEX_PATH=
MATH_AGENT_COMPILE_MODE=trusted_local
MATH_AGENT_REQUIRE_INPUT_TRUST_CONFIRMATION=true
